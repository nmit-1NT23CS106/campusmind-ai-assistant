# Copy to .env and fill in. NEVER commit .env.

# --- LLM: pick ONE provider and set its key ---
LLM_PROVIDER=anthropic          # anthropic | openai | groq | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: override the default model name (model names change; set this if the default is rejected)
LLM_MODEL=

# --- Retrieval ---
RETRIEVER=hybrid                # hybrid | dense | bm25 (falls back to bm25 if the model can't load)

# --- Protect a public demo (it spends YOUR LLM credits) ---
API_TOKEN=                      # if set, every request needs header X-API-Token
ADMIN_TOKEN=                    # if set, role=admin also needs header X-Admin-Token
RATE_LIMIT_PER_MIN=20

# --- UI ---
API_URL=http://localhost:8000
