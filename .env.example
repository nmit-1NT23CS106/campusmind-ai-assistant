# Copy to .env and fill in. NEVER commit .env.
# Keep comments on their own lines (a comment after an empty value is read as the value).

# LLM: pick ONE provider (anthropic, openai, groq or gemini) and set only its key.
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model name. Model names change; set this if the default is rejected.
LLM_MODEL=

# Retrieval: hybrid, dense or bm25 (falls back to bm25 if the embedding model cannot load).
RETRIEVER=hybrid

# Protect a public demo, because it spends YOUR LLM credits. Leave empty when running locally.
# If API_TOKEN is set, every request needs the header X-API-Token.
API_TOKEN=
# If ADMIN_TOKEN is set, the admin role also needs the header X-Admin-Token.
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=20

# The chat UI talks to the API here.
API_URL=http://localhost:8000
